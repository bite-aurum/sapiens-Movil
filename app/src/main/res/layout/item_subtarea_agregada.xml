<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    android:background="@drawable/bg_input_sapiens"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingHorizontal="14dp"
    android:paddingVertical="10dp">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvSubtareaTituloItem"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Revisión bibliográfica"
            android:textColor="#1F2421"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvSubtareaDescItem"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="Capítulos 1 al 3 del manual"
            android:textColor="#6B706B"
            android:textSize="12sp" />
    </LinearLayout>

    <RadioButton
        android:id="@+id/rbSeleccionarSubtarea"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:buttonTint="#1F2421"
        android:clickable="false"
        android:focusable="false" />

</LinearLayout>