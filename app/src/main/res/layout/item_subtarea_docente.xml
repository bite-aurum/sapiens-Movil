<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:layout_marginBottom="12dp"
    android:padding="14dp"
    android:background="@drawable/fondo_tarjeta">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/txtTituloSubtarea"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Subtarea"
                android:textSize="16sp"
                android:textColor="@color/black" />

            <TextView
                android:id="@+id/txtResponsable"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Responsable"
                android:textSize="13sp"
                android:textColor="@color/gris" />
        </LinearLayout>

        <TextView
            android:id="@+id/txtEstadoSubtarea"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_badge_estado"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:paddingTop="3dp"
            android:paddingBottom="3dp"
            android:text="Pendiente"
            android:textSize="12sp" />
    </LinearLayout>


    <TextView
        android:id="@+id/txtSinEvidencia"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="Aún no se ha subido evidencia."
        android:textSize="13sp"
        android:textColor="@color/gris" />


    <LinearLayout
        android:id="@+id/layoutArchivo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="10dp"
            android:padding="12dp"
            android:background="@color/cafeClaro">

            <ImageView
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:src="@drawable/ic_archivo" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginStart="12dp">

                <TextView
                    android:id="@+id/txtNombreArchivo"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="archivo.pdf"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:textColor="@color/black" />

                <TextView
                    android:id="@+id/txtTipoArchivo"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="PDF"
                    android:textSize="12sp"
                    android:textColor="@color/gris" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="10dp">

            <Button
                android:id="@+id/btnVer"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:layout_marginEnd="6dp"
                android:background="@drawable/fondo_borde_verde"
                app:backgroundTint="@null"
                android:drawableStart="@drawable/ic_ver"
                android:drawableTint="@color/verde"
                android:paddingStart="30dp"
                android:paddingEnd="30dp"
                android:text="Ver"
                android:textAllCaps="false"
                android:textColor="@color/verde" />

            <Button
                android:id="@+id/btnDescargar"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                app:backgroundTint="@color/verde"
                android:drawableStart="@drawable/ic_descargar"
                android:drawableTint="@color/white"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:text="Descargar"
                android:textAllCaps="false"
                android:textColor="@color/white" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>